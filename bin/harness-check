#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."

project=$(./bin/runtime project-name)
image=$project-pi-harness
case "$#:${1:-}" in
  1:setup)
    ./bin/runtime storage-admit --protect-image "$image"
    exec ./bin/runtime docker build --target pi-harness --tag "$image" \
      --file etc/docker/cli/Dockerfile etc/docker/cli
    ;;
  0:) ;;
  *) echo 'Usage: ./bin/harness-check [setup]' >&2; exit 2 ;;
esac
if ! ./bin/runtime docker image inspect "$image" >/dev/null 2>&1; then
  echo 'Missing Harness tooling image; run ./bin/harness-check setup.' >&2
  exit 1
fi
exec ./bin/runtime docker run --rm --pull=never --network=none --read-only \
  --label "fight.pi-dependency-reader=$project" \
  --user "$(id -u):$(id -g)" --cap-drop=ALL --security-opt=no-new-privileges:true \
  --pids-limit=256 --memory=2g --cpus=2 --tmpfs /tmp:rw,noexec,nosuid,size=512m \
  --env CI=1 --mount "type=bind,source=$(pwd)/harness/pi,target=/app/harness/pi,readonly" --workdir /app \
  "$image" sh harness/pi/scripts/check.sh

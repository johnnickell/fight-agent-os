#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."
case "$#:${1:-}" in
    0:|1:--force) ;;
    *) echo 'Usage: ./bin/build [--force]' >&2; exit 2 ;;
esac

if ! ./bin/runtime docker compose ps --status running --services | grep -Fxq web; then
  echo "The Compose web service is not running. Start it with ./bin/up." >&2
  exit 1
fi

container=$(./bin/runtime docker compose ps -q web)
expected=$(./bin/runtime docker compose config --hash web | awk '{print $2}')
actual=$(./bin/runtime docker inspect --format '{{ index .Config.Labels "com.docker.compose.config-hash" }}' "$container")
if [ -z "$expected" ] || [ "$actual" != "$expected" ]; then
  echo "The Compose web configuration is stale. Refresh it explicitly with ./bin/up." >&2
  exit 1
fi

./bin/runtime storage-admit
image=$(./bin/runtime docker inspect --format '{{.Image}}' "$container")
runtime_id=$(printf '%s\n%s\n%s\n' "$container" "$image" "$actual" | python3 -c 'import hashlib, sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())')
exec ./bin/runtime docker compose exec -T -e "FIGHT_BUILD_RUNTIME_ID=$runtime_id" web php scripts/build.php "$@"

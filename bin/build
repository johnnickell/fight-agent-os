#!/usr/bin/env sh
set -eu

image=fight-agent-os-build
git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
docker build --file etc/docker/cli/Dockerfile --tag "$image" .
docker run --rm --volume "$(pwd):/app" --volume "$git_common_dir:$git_common_dir:ro" \
  --workdir /app "$image" sh -ec '
  git config --global --add safe.directory /app
  composer validate --strict
  composer install --no-interaction --prefer-dist --no-progress
  composer audit --locked --no-dev

  ./bin/planning-check
  php vendor/bin/phpunit

  work_root=$(mktemp -d)
  trap "rm -rf \"$work_root\" || true" EXIT
  production_root="$work_root/production"
  mkdir "$production_root"
  cp -a . "$production_root"
  cd "$production_root"
  git config --global --add safe.directory "$production_root"
  rm -rf vendor
  composer install --no-dev --no-interaction --prefer-dist --no-progress
  php scripts/production-contract-check.php

  domain_fixture=src/Domain/ProductionContractFixture.php
  application_fixture=src/Application/ProductionContractFixture.php
  mkdir -p "$(dirname "$domain_fixture")" "$(dirname "$application_fixture")"
  cat > "$domain_fixture" <<EOF
<?php
namespace App\\Domain;
final class ProductionContractFixture {}
EOF
  cat > "$application_fixture" <<EOF
<?php
namespace App\\Application;
final class ProductionContractFixture {}
EOF
  php scripts/production-contract-check.php

  cat > "$domain_fixture" <<EOF
<?php
namespace Fight\\Common\\Copied;
final class ProductionContractFixture {}
EOF
  if output=$(php scripts/production-contract-check.php 2>&1); then
    echo "Production contract accepted a copied Fight\\Common namespace." >&2
    exit 1
  fi
  printf "%s\\n" "$output"
  case "$output" in
    *"Fight\\Common\\Copied"*) ;;
    *) echo "Production contract did not identify the copied Fight\\Common namespace." >&2; exit 1 ;;
  esac

  cat > "$domain_fixture" <<EOF
<?php
namespace App\\Domain;
final class ProductionContractFixture {}
EOF
  cat > "$application_fixture" <<EOF
<?php
namespace Fight\\AccessControl\\Copied;
final class ProductionContractFixture {}
EOF
  if output=$(php scripts/production-contract-check.php 2>&1); then
    echo "Production contract accepted a copied Fight\\AccessControl namespace." >&2
    exit 1
  fi
  printf "%s\\n" "$output"
  case "$output" in
    *"Fight\\AccessControl\\Copied"*) ;;
    *) echo "Production contract did not identify the copied Fight\\AccessControl namespace." >&2; exit 1 ;;
  esac
  echo "Production contract negative namespace checks passed."
'

#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")/.."
case "${1:-check}" in
    setup|check) mode=${1:-check} ;;
    *) echo 'Usage: ./bin/pi-dependencies [setup|check]' >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { echo 'Usage: ./bin/pi-dependencies [setup|check]' >&2; exit 2; }
image='node@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205'
./bin/runtime storage-admit
if ! ./bin/runtime docker image inspect "$image" >/dev/null 2>&1; then
    if [ "$mode" = check ]; then
        echo 'Missing Pi tooling image; run ./bin/pi-dependencies setup.' >&2
        exit 1
    fi
    ./bin/runtime docker pull "$image"
fi
project=$(./bin/runtime project-name)
run() {
    ./bin/runtime docker run --rm --name="$project-pi-dependencies" --pull=never --network="$1" --read-only \
        --user "$(id -u):$(id -g)" --cap-drop=ALL --security-opt=no-new-privileges:true \
        --pids-limit=256 --memory=2g --cpus=2 --tmpfs /tmp:rw,nosuid,size=512m \
        --env HOME=/tmp --env CI=1 --env npm_config_update_notifier=false \
        --mount "type=bind,source=$(pwd)/harness/pi,target=/app/harness/pi$2" \
        --workdir /app "$image" node harness/pi/scripts/dependencies.mjs "$3"
}
if run none ',readonly' check; then
    exit 0
else
    status=$?
fi
# Only a failed readiness check permits setup, not Docker admission failure.
[ "$mode" = setup ] && [ "$status" -eq 1 ] || exit "$status"
# Keep the existing application-tooling guard without requiring Compose configuration.
active() {
    ./bin/runtime docker ps --all --filter status=running --filter status=created \
        --filter status=restarting --filter status=paused --filter status=removing "$@"
}
services=$(active --filter "label=com.docker.compose.project=$project" \
    --format '{{.Label "com.docker.compose.service"}}')
if printf '%s\n' "$services" | grep -Exq 'web|composer'; then
    echo "Pi dependencies need replacement. Finish active checks and one-off tooling, then stop this checkout's web service and rerun ./bin/pi-dependencies setup." >&2
    exit 1
fi
run bridge '' setup

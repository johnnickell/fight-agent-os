#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")/.."
case "${1:-}" in
    up)
        ./bin/runtime docker compose --profile mail up --detach --no-deps mailcatcher
        printf '%s\n' 'Mailpit is private to this installation; no host/browser port is published.'
        ;;
    status)
        ./bin/runtime docker compose --profile mail ps mailcatcher
        ;;
    clear)
        # Removing this service destroys its tmpfs mailbox; never touches application databases.
        ./bin/runtime docker compose --profile mail rm --stop --force mailcatcher
        ./bin/runtime docker compose --profile mail up --detach --no-deps mailcatcher
        ;;
    down)
        ./bin/runtime docker compose --profile mail rm --stop --force mailcatcher
        ;;
    *)
        echo 'Usage: ./bin/mail-catcher {up|status|clear|down}' >&2
        exit 2
        ;;
esac

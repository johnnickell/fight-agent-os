#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."

if ! ./bin/runtime docker compose ps --status running --services | grep -Fxq web; then
    echo 'The Compose web service is not running. Start it with ./bin/up.' >&2
    exit 1
fi

exec ./bin/runtime docker compose exec -T -e APP_ENV=test -e XDEBUG_MODE=coverage web php scripts/backend_tests.php

#!/usr/bin/env sh
set -eu

if [ "$#" -eq 0 ]; then
  exec docker compose exec -T web \
    php vendor/bin/deptrac analyse --config-file=deptrac.php --formatter=table --no-progress \
    --report-uncovered --fail-on-uncovered
fi

exec docker compose exec -T --env DEPTRAC_PATHS="$1" web \
  php vendor/bin/deptrac analyse --config-file=deptrac.php --formatter=table --no-progress \
  --report-uncovered --fail-on-uncovered

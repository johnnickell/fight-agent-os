#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."
for tool in docker python3 openssl curl; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "Missing $tool. Install local HTTPS prerequisites; see docs/engineering/LOCAL_HTTPS.md." >&2
        exit 1
    }
done
if [ ! -f vendor/autoload.php ]; then
    echo "Dependencies are not installed. Run: ./bin/composer install --no-interaction --prefer-dist --no-progress" >&2
    exit 1
fi

# Validate effective Compose settings and existing leaves before any service mutation.
# Startup never enrolls trust, generates certificates or edits configuration.
python3 scripts/local_https.py startup

# Prepare only ignored writable cache/report mounts before Compose starts the service.
./bin/runtime paths .runs/cache/client/dependency-cache .runs/cache/client/vite-temp var \
    client/node_modules/.cache client/node_modules/.vite-temp

if ! ./bin/runtime docker compose --profile https up --detach --build --wait --wait-timeout 120 web https; then
    echo "Stack startup/readiness failed; services may be partially running. Inspect docker compose --profile https ps, correct the failure, then rerun ./bin/up." >&2
    exit 1
fi

# Validate and reload leaf/configuration changes on an already-running gateway.
if ! ./bin/runtime docker compose --profile https exec -T https nginx -t ||
   ! ./bin/runtime docker compose --profile https exec -T https nginx -s reload; then
    echo "HTTPS gateway validation/reload failed; services may be partially running. Correct the gateway configuration and rerun ./bin/up." >&2
    exit 1
fi

# Compose --wait alone only proves these services are running, not serving PHP/TLS.
# Discover the loopback mapping while retaining the canonical TLS name and HTTP authority.
address=$(./bin/runtime docker compose --profile https port https 8443)
port=${address##*:}
case "$address" in
    127.0.0.1:*) ;;
    *) echo "HTTPS requires a loopback port mapping; correct Compose configuration and rerun ./bin/up." >&2; exit 1 ;;
esac
if ! curl --fail --silent --show-error --retry 10 --retry-delay 1 --retry-all-errors \
    --connect-timeout 5 --max-time 10 --retry-max-time 60 \
    --connect-to "localhost:18443:127.0.0.1:$port" \
    --output /dev/null https://localhost:18443/; then
    echo "Verified HTTPS readiness failed; services may be partially running. Check local trust, application keys/assets and gateway logs (build missing assets with ./bin/client build). Run ./bin/https setup only if enrollment/leaves need repair, then rerun ./bin/up." >&2
    exit 1
fi
./bin/runtime docker compose port web 8080
echo "https://localhost:18443"

#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")/.."

if ! docker compose ps --status running --services | grep -Fxq web; then
    echo 'The Compose web service is not running. Start it with ./bin/up.' >&2
    exit 1
fi

docker compose exec -T web php scripts/openapi.php "$@"
if [ "${1:-check}" = 'check' ]; then
    exec docker compose exec -T web php vendor/bin/phpunit tests/Functional/Http tests/Unit/Http/ApiFailureMapperTest.php
fi

#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")/.."
mkdir -p .runs/client/dependency-cache .runs/client/vite-temp var \
    client/node_modules/.cache client/node_modules/.vite-temp
# Only the explicit maintenance service mounts source writable.
exec docker compose run --rm --user "$(id -u):$(id -g)" \
    -e COMPOSER_ROOT_VERSION=dev-develop \
    -e COMPOSER_HOME=/app/.runs/composer \
    -e COMPOSER_CACHE_DIR=/app/.runs/composer/cache composer composer "$@"

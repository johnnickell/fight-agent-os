{
  "name": "johnnickell/fight-agent-os",
  "description": "An extensible personal AI operating system built on Fight libraries and Pi.",
  "license": "MIT",
  "type": "project",
  "require": {
    "doctrine/dbal": "^4.3",
    "doctrine/migrations": "^3.9",
    "doctrine/orm": "^3.5",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "guzzlehttp/guzzle": "^7.10",
    "php": ">=8.5",
    "johnnickell/fight-access-control": "^0.3.0",
    "johnnickell/fight-common": "~1.2.0",
    "lcobucci/jwt": "^5.6",
    "league/flysystem": "^3.30",
    "league/flysystem-local": "^3.30",
    "monolog/monolog": "^3.9",
    "psr/cache": "^3.0",
    "psr/container": "^2.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.15",
    "symfony/cache": "^8.1",
    "symfony/filesystem": "^8.1",
    "symfony/mailer": "^8.1",
    "symfony/mercure": "^0.7",
    "symfony/process": "^8.1",
    "symfony/validator": "^8.1",
    "twig/twig": "^3.22"
  },
  "require-dev": {
    "deptrac/deptrac": "^4.7",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "repositories": [
    {"type": "vcs", "url": "https://github.com/johnnickell/fight-common", "no-api": true},
    {"type": "vcs", "url": "https://github.com/johnnickell/fight-access-control", "no-api": true}
  ],
  "config": {"platform": {"php": "8.5.4"}, "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {"test": "phpunit"}
}

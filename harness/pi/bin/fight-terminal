#!/bin/sh
set -eu

fail() { printf '%s\n' "fight-terminal: $*" >&2; exit 1; }
command -v node >/dev/null 2>&1 || fail 'Node.js 22 or later is required on PATH. Install Node, then retry.'
# npm exposes this file through a symlink. Resolve only our executable, never the caller's project.
launcher=$0
case "$launcher" in
  /*) ;;
  *) launcher="$PWD/$launcher" ;;
esac
links=0
while [ -L "$launcher" ]; do
  links=$((links + 1))
  [ "$links" -le 40 ] || fail 'Launcher symlink loop. Inspect command -v fight-terminal and reinstall the trusted package.'
  directory=$(CDPATH='' cd -P "$(dirname "$launcher")" && pwd) || fail 'Installed package is unavailable. Reinstall from its current trusted source.'
  target=$(readlink "$launcher") || fail 'Cannot resolve installed launcher. Reinstall the trusted package.'
  case "$target" in
    /*) launcher=$target ;;
    *) launcher="$directory/$target" ;;
  esac
done
directory=$(CDPATH='' cd -P "$(dirname "$launcher")" && pwd) || fail 'Installed package is unavailable. Reinstall from its current trusted source.'
main="$directory/../src/workspace/main.mjs"
[ -r "$main" ] || fail 'Installed retirement notice is missing. Use ordinary pi; inspect the trusted package README.md before explicit adoption.'
# Compatibility notice only. Never resolve/launch Pi, Herdr, Docker or the retired RPC editor.
# Keep this package-owned bin so an explicitly upgraded installation explains session migration.
exec node "$main" "$@"

{
  "name": "fight-agent-os-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.catalog.json",
    "lint": "eslint . --max-warnings=0",
    "lint-fix": "eslint . --fix --max-warnings=0",
    "format-check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "build-check": "node scripts/build.mjs --check",
    "storybook-build": "storybook build --disable-telemetry --output-dir ../.runs/client/storybook && node scripts/finalize-catalog-build.mjs",
    "storybook-dev": "storybook dev --ci --no-open --disable-telemetry --host 0.0.0.0 --port 6006",
    "storybook-test": "vitest run --config vitest.storybook.config.ts",
    "storybook-capture": "node scripts/capture-catalog.mjs"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "react": "19.3.0",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "storybook": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.61.0",
    "axe-core": "4.13.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "sass": "1.105.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}

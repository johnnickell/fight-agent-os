# Exact registered name only; no wildcard, global TLD or default-server changes.
server {
    listen 127.0.0.1:80;
    server_name @HOST@;
    access_log off;
    error_log /dev/null;
    if ($request !~ "^[^ ]+ /") { return 421; }
    if ($http_host != "@HOST@") { return 421; }
    return 308 https://@HOST@$request_uri;
}
server {
    listen 127.0.0.1:443 ssl;
    server_name @HOST@;
    access_log off;
    error_log /dev/null;
    ssl_certificate "@STATE@/certs/@HOST@/localhost.pem";
    ssl_certificate_key "@STATE@/certs/@HOST@/localhost-key.pem";
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($request !~ "^[^ ]+ /") { return 421; }
    if ($http_host != "@HOST@") { return 421; }
    if ($ssl_server_name != "@HOST@") { return 421; }
    location / {
        proxy_pass https://127.0.0.1:@PORT@;
        proxy_ssl_server_name on;
        proxy_ssl_name @HOST@;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 2;
        proxy_ssl_trusted_certificate "@STATE@/certs/rootCA.pem";
        proxy_set_header Host @HOST@;
        include "@STATE@/proxy-headers.conf";
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_redirect off;
    }
}

<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Fight Agent OS">
    <description>Apply the locked Fight Common 1.2 standard to owned PHP</description>
    <file>bootstrap</file>
    <file>cli-config.php</file>
    <file>config</file>
    <file>database/migrations</file>
    <file>deptrac.php</file>
    <file>migrations.php</file>
    <file>public</file>
    <file>rector.php</file>
    <file>scripts</file>
    <file>src</file>
    <file>tests</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>
    <exclude-pattern>*/.runs/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <rule ref="./vendor/johnnickell/fight-common/src/Standards/Phpcs/ruleset.xml"/>
</ruleset>

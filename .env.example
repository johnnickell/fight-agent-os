# Local-only examples; provide environment-specific secrets outside the repository.
# Stable section identifiers group related settings; define each variable only once.

# [application]
# Canonical developer environment, shared by HTTP and opt-in TLS; test keeps separate database guards.
# Strict true/false diagnostics; absent means false. True in prod/production refuses startup.
# Debug never authorizes Swagger or exposes secrets. Use false for staging/production.
APP_ENV=local
APP_DEBUG=true
# Exact JSON names, independent of debug and current READ_SWAGGER; [] disables everywhere.
# Absent/malformed/unlisted fails closed. Non-local opt-in needs separate security qualification.
APP_SWAGGER_ALLOWED_ENVIRONMENTS='["local"]'
# PHP diagnostics always go to Docker stderr. Opt in to triggered IDE debugging locally only.
XDEBUG_MODE=off

# [http]
FIGHT_AGENT_OS_PORT=18087

# [storage]
# Export these host-shell settings (Compose .env alone does not configure host wrappers).
# Host reserve plus allocation allowance; no automatic shared-storage reclamation or global prune.
# FIGHT_STORAGE_RESERVE_BYTES=21474836480
# FIGHT_STORAGE_ALLOCATION_BYTES=4294967296
# TASK builds use one dedicated native builder/cache and the same task resource record/cleanup path.
# See docs/engineering/RESOURCE_LIFECYCLE.md; completed tasks do not retain temporary archives by default.

# [database]
POSTGRES_DB=agent_os
POSTGRES_USER=agent_os
POSTGRES_PASSWORD=replace-local-development-password

# [test_database]
POSTGRES_TEST_DB=agent_os_test
POSTGRES_TEST_USER=agent_os_test
POSTGRES_TEST_PASSWORD=replace-local-test-password

# [browser_security]
# Set these outside version control before boot; generate an independent key with openssl rand -hex 32.
# Use ./bin/https setup for opt-in https://localhost:18443; it preserves the existing CSRF key.
# The origin must be the exact HTTPS browser origin; the HTTP port above cannot serve auth bootstrap.
APP_BROWSER_ORIGIN=
APP_CSRF_MAC_KEY=
# Independent hex-encoded 32-byte key for secret-safe activation admission dimensions
APP_ACTIVATION_RATE_KEY=
# Independent random 32-byte hex authentication throttle key; never reuse CSRF/signing keys.
APP_AUTH_RATE_KEY=
# Rolling 900-second per-peer and per-endpoint budgets; may be lowered, not raised past these maxima.
APP_AUTH_NETWORK_LIMIT=20
APP_AUTH_ENDPOINT_LIMIT=300
# Direct server TLS authority only. Forwarded-header/proxy promotion is not supported.
APP_AUTH_TRANSPORT=direct
APP_AUTH_TRUSTED_PROXIES=[]

# [access_tokens]
# Required external ordered JSON keyring; see docs/engineering/ACCESS_TOKENS.md for its exact shape.
# Generate independent environment-specific keys; never reuse CSRF, delivery or request-HMAC keys.
APP_ACCESS_TOKEN_CONFIG=

# [credential_delivery]
# Independent 32-byte random key, hex-encoded (openssl rand -hex 32), external to source control.
# Retain the key for the lifetime of outstanding encrypted invitation/reset work; losing it makes work unrecoverable.
# Local/test defaults to retryable null; memory simulates outcomes without sending.
# catcher sends invitations and password resets only to the disposable Compose mailcatcher (./bin/mail-catcher up).
# Production-like HTTP boot and delivery preflight refuse every available adapter; no real vendor is enrolled.
APP_CREDENTIAL_DELIVERY_KEY=
APP_CREDENTIAL_DELIVERY_ADAPTER=null
# Atomic invitation API actor/action and recovery actor/action/target budgets; see docs/engineering/INVITATION_API.md.
APP_INVITATION_RATE_WINDOW=60
APP_INVITATION_RATE_ISSUE_LIMIT=10
APP_INVITATION_RATE_STATUS_LIMIT=60
APP_INVITATION_RATE_CAPACITY=10000
APP_INVITATION_RATE_RETRY_LIMIT=5
APP_INVITATION_RATE_RESEND_LIMIT=3
APP_INVITATION_RATE_CORRECT_LIMIT=3

# [invitation_email]
# Required for catcher mode and production-like delivery composition. Explicit canonical HTTPS origin/path only.
# No request Host/forwarded values, query, fragment, userinfo, IP hosts, trailing dot or encoded/dot path segments.
# Must match APP_BROWSER_ORIGIN and the supported public route. No global trust changes are automatic.
APP_ACTIVATION_ORIGIN=https://localhost:18443
APP_ACTIVATION_PATH=/app/activate
# [password_reset_email]
# Required alongside activation configuration for catcher/production-like delivery composition.
# Canonical example only: reset request/completion HTTP/UI remain separate work.
APP_PASSWORD_RESET_ORIGIN=https://localhost:18443
APP_PASSWORD_RESET_PATH=/reset-password
# Catcher UI/API is loopback-only; SMTP is private to this Compose project. No real inbox delivery.
FIGHT_AGENT_OS_MAIL_PORT=18088

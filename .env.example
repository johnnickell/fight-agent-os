# Local-only defaults; provide environment-specific secrets outside the repository.
POSTGRES_DB=agent_os
POSTGRES_USER=agent_os
POSTGRES_PASSWORD=replace-local-development-password
POSTGRES_TEST_DB=agent_os_test
POSTGRES_TEST_USER=agent_os_test
POSTGRES_TEST_PASSWORD=replace-local-test-password
FIGHT_AGENT_OS_PORT=18087
# Set these outside version control before boot; generate an independent key with openssl rand -hex 32.
# The origin must be the exact HTTPS browser origin; the current HTTP-only development port cannot serve auth bootstrap.
APP_BROWSER_ORIGIN=
APP_CSRF_MAC_KEY=
